{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/website/index.html" },
    {
      "source": "/category/:cat",
      "destination": "/website/category/:cat.html"
    },
    {
      "source": "/prompt/:cat/:slug",
      "destination": "/website/prompt/:cat/:slug.html"
    },
    { "source": "/sitemap.xml", "destination": "/website/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/website/robots.txt" },
    { "source": "/llms.txt", "destination": "/website/llms.txt" }
  ]
}
